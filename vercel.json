{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix server install && npm --prefix client install --include=dev",
  "buildCommand": "npm --prefix client run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/uploads/:path*", "destination": "/api" },
    { "source": "/((?!api|uploads).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 10 }
  }
}
