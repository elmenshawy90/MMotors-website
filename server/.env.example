# Server
PORT=5000

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# PostgreSQL Database
# Option A (recommended — Vercel + Prisma Postgres / Neon / Supabase):
#   DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=require
# When DATABASE_URL is set it takes precedence over the DB_* vars below.
DATABASE_URL=
# Option B (local Docker dev via docker-compose.yml):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=car_dealership
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Secret (used to sign admin login tokens)
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=24h
